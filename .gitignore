# WordPress Plugin .gitignore

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
error_log
debug.log

# Temporary files
*.tmp
*.temp

# Node modules (if using build tools)
node_modules/
npm-debug.log*

# Composer (dev tooling only)
vendor/

# Build files
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# Backup files
*.bak
*.backup
*~

# WordPress specific
wp-config.php
wp-content/uploads/
wp-content/blogs.dir/
wp-content/upgrade/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
wp-content/cache/
wp-content/cache/supercache/

# Plugin specific ignores
languages/*.po
languages/*.mo
!languages/*.pot
